rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /articles/{articleId} {
      // News is served by the authenticated application API and its durable store.
      // Client SDKs must never bypass the editorial publication workflow.
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /briefcases/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
