# Node 22.12+ (22.x). Existing environment values take precedence over these files.
# Copy to .env.local for local use, .env for Docker Compose. Never commit secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SITE_URL=https://theatlastimes.com
MONGODB_URI=
MONGODB_DB_NAME=the_atlas_times
# SQLite is for local development only; production normally requires MongoDB.
NEWS_DB_PATH=data/news.db
# NEWS_STORAGE=sqlite
# Set only when the app is behind this many trusted reverse proxies.
TRUST_PROXY_HOPS=

# Generate two DIFFERENT secrets, each at least 32 characters; leave blank to disable.
# Editor: publish/update/delete/export. Ingestion: source drafts/ingest/analyze only.
NEWS_API_KEY=
NEWS_INGEST_KEY=

# Public readers need no login. Editorial users sign in with Firebase email/password
# and must have custom claim editor=true or admin=true (set through trusted Admin SDK).
# Browser and Admin default to firebase-applet-config.json. Use the same project.
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT=  # Secret JSON alternative for Vercel; never VITE_
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# Optional public Firebase browser config JSON, supplied at build time:
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# Only approved/licensed HTTPS RSS feeds. Collection creates private drafts.
ENABLE_INGESTION=false
FEED_URLS=[]
FEED_POLL_MS=1800000
DGX_WORKER_CONCURRENCY=1
DGX_WORKER_POLL_MS=5000
AI_JOB_LEASE_MS=180000
AI_JOB_MAX_ATTEMPTS=3

# DGX Spark: vLLM/NIM/Ollama OpenAI-compatible endpoint, reached privately.
AI_EXECUTION=worker
AI_PROVIDER=disabled
AI_BASE_URL=http://127.0.0.1:8001/v1
AI_MODEL=
AI_API_KEY=
# Optional server-specific settings; verified with the Spark's existing Qwen service.
AI_JSON_MODE=false
AI_DISABLE_THINKING=false

# Optional cloud alternative. Explicit provider/model required; no implicit fallback.
GEMINI_API_KEY=
GEMINI_MODEL=

# Remote pull/draft-push CLI destination; require HTTPS except private loopback/tunnel.
ATLAS_API_URL=http://127.0.0.1:3000
# Legacy export uses read-only Firebase Admin credentials and configured database.
LEGACY_FIREBASE_DATABASE_ID=
