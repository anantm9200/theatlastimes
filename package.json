{
  "name": "the-atlas-times",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --outDir dist/client && esbuild server.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/server.mjs && esbuild scripts/dgx-worker.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/dgx-worker.mjs",
    "start": "node dist/server.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/server/*.test.ts tests/*.test.ts",
    "news:backup": "tsx scripts/news-backup.ts",
    "news:import": "tsx scripts/news-import.ts",
    "dgx:check": "tsx scripts/dgx-check.ts",
    "news:sync": "tsx scripts/news-sync.ts",
    "news:export-legacy": "tsx scripts/export-legacy-firestore.ts",
    "worker": "node dist/dgx-worker.mjs",
    "dgx:worker": "node dist/dgx-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "entities": "^8.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.17.0",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=22.12 <23"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
