{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && node scripts/build-client-assets.mjs",
  "outputDirectory": "dist/client",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/article/([^/]+)",
      "dest": "/api/index"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml|news-sitemap\\.xml|rss\\.xml|feed\\.xml)",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
