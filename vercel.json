{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": "{.env*,data/**,backups/**,artifacts/**,graphify-out/**,tests/**,**/*.test.ts}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/news-placeholder.svg",
      "dest": "/news-placeholder.svg"
    },
    {
      "src": "/The%20Atlas%20Times.png",
      "dest": "/The Atlas Times.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
